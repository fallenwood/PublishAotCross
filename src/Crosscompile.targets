<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import Project="$(MSBuildThisFileDirectory)ToolsetsVersion.props" />
  <Import Project="$(MSBuildThisFileDirectory)RestoreToolchain.targets" />

  <PropertyGroup>
    <DisableUnsupportedError>true</DisableUnsupportedError>
    <AotPreferCustom Condition="'$(AotPreferCustom)' == ''">false</AotPreferCustom>
    <HostRuntimeIdentifier Condition="'$(HostRuntimeIdentifier)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</HostRuntimeIdentifier>
    <UseExternalZig Condition="'$(UseExternalZig)' == ''">false</UseExternalZig>
    <GlibcVersion Condition="'$(GlibcVersion)' == ''" />
  </PropertyGroup>

  <UsingTask TaskName="PrependPathIfCrossCompile"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">

    <ParameterGroup>
      <MSBuildThisFileDirectory ParameterType="System.String" Required="true" />
      <RuntimeIdentifier ParameterType="System.String" Required="true" />
      <HostRuntimeIdentifier ParameterType="System.String" Required="true" />
      <ZigPath ParameterType="System.String" />
      <ConfigureEnvironment ParameterType="System.Boolean" />
      <AotPreferCustom ParameterType="System.Boolean" Required="true" />
      <UseExternalZig ParameterType="System.Boolean" Required="true" />
      <!-- Out Variables -->
      <CustomAotToolChain ParameterType="System.String" Output="true"/>
    </ParameterGroup>

    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Diagnostics" />
      <Using Namespace="System.Runtime.InteropServices" />

      <Code Type="Fragment" Language="cs" Source="$(MSBuildThisFileDirectory)/Scripts/SetPath.cs">
      </Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="CreateXwinLibraryOverlay"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <LibraryDirectories ParameterType="System.String[]" Required="true" />
      <OverlayPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs" Source="$(MSBuildThisFileDirectory)Scripts/CreateXwinLibraryOverlay.cs" />
    </Task>
  </UsingTask>

  <Target Name="SelectAotToolchain">
    <PrependPathIfCrossCompile
      MSBuildThisFileDirectory="$(MSBuildThisFileDirectory)"
      HostRuntimeIdentifier="$(HostRuntimeIdentifier)"
      RuntimeIdentifier="$(RuntimeIdentifier)"
      AotPreferCustom="$(AotPreferCustom)"
      UseExternalZig="$(UseExternalZig)">
      <Output TaskParameter="CustomAotToolChain" PropertyName="CustomAotToolChain" />
    </PrependPathIfCrossCompile>
  </Target>

  <Target
    Name="SetPathToClang"
    BeforeTargets="SetupOSSpecificProps"
    DependsOnTargets="SelectAotToolchain;RestoreAotToolchain">
    <PrependPathIfCrossCompile
      MSBuildThisFileDirectory="$(MSBuildThisFileDirectory)"
      RuntimeIdentifier="$(RuntimeIdentifier)"
      HostRuntimeIdentifier="$(HostRuntimeIdentifier)"
      ConfigureEnvironment="true"
      ZigPath="$(ZigPath)"
      AotPreferCustom="$(AotPreferCustom)"
      UseExternalZig="$(UseExternalZig)">
      <Output TaskParameter="CustomAotToolChain" PropertyName="CustomAotToolChain"/>
    </PrependPathIfCrossCompile>

    <PropertyGroup Condition="'$(CustomAotToolChain)' == 'xwin' and $(RuntimeIdentifier.StartsWith('win'))">
      <IlcUseEnvironmentalTools>true</IlcUseEnvironmentalTools>
    </PropertyGroup>
  </Target>

  <!-- BEGIN: Works around ILCompiler targets not detecting this as a cross compilation -->
  <Target Name="OverwriteTargetTriple"
          AfterTargets="SetupOSSpecificProps"
          BeforeTargets="LinkNative">

    <PropertyGroup Condition=" '$(CustomAotToolChain)' == 'zig' ">
      <CrossCompileRid />
      <CrossCompileRid>$(RuntimeIdentifier)</CrossCompileRid>

      <CrossCompileArch />
      <CrossCompileArch Condition="$(CrossCompileRid.EndsWith('-x64'))">x86_64</CrossCompileArch>
      <CrossCompileArch Condition="$(CrossCompileRid.EndsWith('-arm64'))">aarch64</CrossCompileArch>
      <CrossCompileArch Condition="$(CrossCompileRid.EndsWith('-arm'))">arm</CrossCompileArch>

      <GlibcSuffix Condition="'$(GlibcVersion)' != ''">.$(GlibcVersion)</GlibcSuffix>

      <TargetTriple />
      <TargetTriple Condition="'$(CrossCompileArch)' != '' and $(CrossCompileRid.StartsWith('linux'))">$(CrossCompileArch)-linux-gnu$(GlibcSuffix)</TargetTriple>
      <TargetTriple Condition="'$(CrossCompileArch)' != '' and ($(CrossCompileRid.StartsWith('linux-musl')) or $(CrossCompileRid.StartsWith('alpine')))">$(CrossCompileArch)-linux-musl</TargetTriple>
      <TargetTriple Condition="'$(CrossCompileArch)' == 'arm' and $(CrossCompileRid.StartsWith('linux-musl'))">thumb-linux-musleabihf</TargetTriple>
      <TargetTriple Condition="'$(CrossCompileArch)' != '' and $(CrossCompileRid.StartsWith('osx'))">$(CrossCompileArch)-macos</TargetTriple>
    </PropertyGroup>

    <ItemGroup Condition=" '$(CustomAotToolChain)' == 'zig' ">
      <LinkerArg Include="--target=$(TargetTriple)" />
    </ItemGroup>

    <PropertyGroup Condition=" '$(CustomAotToolChain)' == 'xwin' ">
      <CrossCompileRid />
      <CrossCompileRid>$(RuntimeIdentifier)</CrossCompileRid>

      <CrossCompileArch />
      <CrossCompileArch Condition="$(CrossCompileRid.EndsWith('-x64'))">x64</CrossCompileArch>
      <CrossCompileArch Condition="$(CrossCompileRid.EndsWith('-arm64'))">arm64</CrossCompileArch>

      <CppLinker>$(_AotRestoredCppLinker)</CppLinker>
      <IlcUseEnvironmentalTools Condition="$(HostRuntimeIdentifier.StartsWith('win'))">true</IlcUseEnvironmentalTools>

      <_XWinStore>$(_AotRestoredXWinStore)</_XWinStore>
    </PropertyGroup>

    <Error Condition="'$(CustomAotToolChain)' == 'xwin' and '$(_XWinStore)' == ''"
           Text="XWin SDK/CRT store is missing after toolchain restore." />

    <PropertyGroup Condition="'$(CustomAotToolChain)' == 'xwin' and !$(HostRuntimeIdentifier.StartsWith('win-'))">
      <_XWinLibraryOverlay>$([System.IO.Path]::GetFullPath('$(NativeIntermediateOutputPath)xwin-libraries.yaml'))</_XWinLibraryOverlay>
    </PropertyGroup>
    <CreateXwinLibraryOverlay
      Condition="'$(CustomAotToolChain)' == 'xwin' and !$(HostRuntimeIdentifier.StartsWith('win-'))"
      LibraryDirectories="$(_XWinStore)/splat/sdk/lib/ucrt/$(CrossCompileArch);$(_XWinStore)/splat/sdk/lib/um/$(CrossCompileArch);$(_XWinStore)/splat/crt/lib/$(CrossCompileArch)"
      OverlayPath="$(_XWinLibraryOverlay)" />

    <ItemGroup Condition=" '$(CustomAotToolChain)' == 'xwin' ">
      <_NoExpLinkerArg Include="@(LinkerArg->Replace('/NOEXP', ''))" />
      <_NoExpLinkerArg Remove="@(_NoExpLinkerArg)" Condition="$([System.String]::new('%(Identity)').StartsWith('/SOURCELINK:'))" />
      <LinkerArg Remove="@(LinkerArg)" />

      <LinkerArg Include="/vctoolsdir:$(_XWinStore)/splat/crt" />
      <LinkerArg Include="/winsdkdir:$(_XWinStore)/splat/sdk" />
      <LinkerArg Include="/LIBPATH:$(_XWinStore)/splat/sdk/lib/ucrt/$(CrossCompileArch)/" />
      <LinkerArg Include="/LIBPATH:$(_XWinStore)/splat/sdk/lib/um/$(CrossCompileArch)/" />
      <LinkerArg Include="/LIBPATH:$(_XWinStore)/splat/crt/lib/$(CrossCompileArch)/" />

      <LinkerArg Include="/vfsoverlay:&quot;$(_XWinLibraryOverlay)&quot;" Condition="!$(HostRuntimeIdentifier.StartsWith('win-'))" />
      <LinkerArg Include="@(_NoExpLinkerArg)" />
    </ItemGroup>

  </Target>
  <!-- END: Works around ILCompiler targets not detecting this as a cross compilation -->

</Project>
