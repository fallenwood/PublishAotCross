#! /usr/bin/env bash

set -x

if ! command -v zig > /dev/null; then
  echo "Error: zig is not on the PATH. Install zig and make sure it's on PATH. Follow instructions at https://github.com/fallenwood/PublishAotCross" >&2
  exit 1
fi

# Force the NativeAOT module to survive linker garbage collection.
zig_args=("-Wl,-u,__Module")

# Transform complete arguments, never substrings in a flattened command line.
# This preserves filenames with spaces, literal glob characters, and empty args.
for arg in "$@"; do
  case "$arg" in
    -lz|-Wl,-pie|-pie|-Wl,-e0x0|-Wl,--defsym,__xmknod=mknod)
      continue
      ;;
    -static-pie)
      # Match the Windows wrapper's Zig workaround: static, not static PIE.
      arg=-static
      ;;
    -Wl,--discard-all)
      arg=-Wl,--as-needed
      ;;
    --discard-all)
      arg=--as-needed
      ;;
    "'-Wl,-rpath,\$ORIGIN'")
      # Work around the quoted rpath emitted by older .NET versions.
      arg='-Wl,-rpath,$ORIGIN'
      ;;
  esac
  zig_args+=("$arg")
done

exec zig cc "${zig_args[@]}"
