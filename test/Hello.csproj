<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework>
    <StaticExecutable Condition="'$(StaticExecutable)' == ''">false</StaticExecutable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(StaticExecutable)' == 'true'">
    <InvariantGlobalization Condition="'$(InvariantGlobalization)' == ''">true</InvariantGlobalization>
    <!-- Keep static and non-static NativeAOT outputs separate for incremental builds. -->
    <BaseOutputPath>bin/static/</BaseOutputPath>
    <IntermediateOutputPath>obj/static/$(Configuration)/</IntermediateOutputPath>
  </PropertyGroup>

  <Import Project="../src/Fallenwood.PublishAotCross.targets" />
</Project>
